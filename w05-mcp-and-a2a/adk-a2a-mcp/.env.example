# LLM used by both ADK agents
GOOGLE_API_KEY=
ADK_MODEL=gemini-3.7-flash

# Composio project and identity
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# Existing Outlook auth/account supplied for this workshop
COMPOSIO_AUTH_CONFIG_ID=ac_-VUnfyXRcOFR
COMPOSIO_CONNECTED_ACCOUNT_ID=ca_XNWTVw6SIgaJ

# Donde Agent A busca la Agent Card de Agent B.
# Con `adk web --a2a` (un solo proceso, puerto 8000) dejalo asi.
# Si corres Agent B aparte con `adk api_server --a2a --port 8001`, usa:
#   http://127.0.0.1:8001/a2a/outlook_agent
OUTLOOK_AGENT_URL=http://127.0.0.1:8000/a2a/outlook_agent
