# Copia a .env y completa las keys.
# Google: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Langfuse: Settings → API Keys. Sin esto, ADK Web funciona igual.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU (default). US: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
